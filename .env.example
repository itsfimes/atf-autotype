# ATF Autotype Configuration
# Copy this file to .env and fill in your API keys

# Mistral API Key (for OCR)
MISTRAL_API_KEY="your_mistral_api_key_here"

# Monitor configuration
MONITOR_ID=1

# Typing speed (keystrokes per minute)
TYPING_SPEED=260

# Keyboard layout settings
SWITCH_KB_LAYOUT_ON_START=false
FIX_QWERTY=true

# Screen dimensions (optional - will auto-detect if not set)
SCREEN_W=1920
SCREEN_H=1080
